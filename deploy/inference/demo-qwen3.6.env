# The demo with Qwen3.6-35B-A3B: the same rented node as `demo-qwen3.8.env`, serving Qwen3.6-35B-A3B.
# NOT YET MEASURED on this path.
#
# `demo.py up --model 3.6` serves Qwen/Qwen3.6-35B-A3B at full precision. Its 72 GB of weights need a
# card of 94 GB or more, which demo.py checks before it rents anything. Everything `demo-qwen3.8.env`
# says about where conversation text goes and where the key is holds here unchanged: read it before
# using this.
#
#     python3 deploy/gpu/controller/demo.py up --workdir ~/.taisce-demo --model 3.6
#     export TAISCE_INFERENCE_API_KEY="$(cat ~/.taisce-demo/api_key)"
#     export OPENROUTER_API_KEY=<your OpenRouter key>
#     make test-inference INFERENCE_PROFILE=demo-qwen3.6
#     python3 deploy/gpu/controller/demo.py down --workdir ~/.taisce-demo
#
# Until that corpus run is recorded in docs/36-extraction-models.md, a result from this profile is not
# qualified. An 8-bit build of the same family passed 19 of 19 with thinking on (docs/36); this one
# serves it with thinking off, which has not been run through the corpus for this family.

TAISCE_INFERENCE_ENDPOINT=${TAISCE_INFERENCE_ENDPOINT:-http://localhost:18000/v1}
TAISCE_INFERENCE_EXTRACTOR_MODEL=${TAISCE_INFERENCE_EXTRACTOR_MODEL:-Qwen/Qwen3.6-35B-A3B}
TAISCE_INFERENCE_API_KEY=${TAISCE_INFERENCE_API_KEY:-}

TAISCE_INFERENCE_EMBEDDING_ENDPOINT=${TAISCE_INFERENCE_EMBEDDING_ENDPOINT:-https://openrouter.ai/api/v1}
TAISCE_INFERENCE_EMBEDDING_MODEL=${TAISCE_INFERENCE_EMBEDDING_MODEL:-qwen/qwen3-embedding-4b}
TAISCE_INFERENCE_EMBEDDING_API_KEY=${TAISCE_INFERENCE_EMBEDDING_API_KEY:-${OPENROUTER_API_KEY:-}}

TAISCE_INFERENCE_ALLOWLIST=${TAISCE_INFERENCE_ALLOWLIST:-localhost:18000,openrouter.ai}
