# The demo with Qwen3.6-35B-A3B: the same rented node as `demo-qwen3.8.env`, serving the local
# default's model family. NOT YET MEASURED on this path.
#
# `demo.py up --model 3.6` serves Qwen/Qwen3.6-35B-A3B at full precision, where the local default runs
# an 8-bit build of it. Its 72 GB of weights need a card of 94 GB or more, which demo.py checks before
# it rents anything. Everything `demo-qwen3.8.env` says about where conversation text goes and where
# the key is holds here unchanged: read it before using this.
#
#     python3 deploy/gpu/controller/demo.py up --workdir ~/.taisce-demo --model 3.6
#     export TAISCE_INFERENCE_API_KEY="$(cat ~/.taisce-demo/api_key)"
#     make test-inference INFERENCE_PROFILE=demo-qwen3.6
#     python3 deploy/gpu/controller/demo.py down --workdir ~/.taisce-demo
#
# Until that corpus run is recorded in docs/36-extraction-models.md, a result from this profile is not
# qualified. The local build of the same family passes 19 of 19 with thinking on; this one serves it
# with thinking off, which has not been run through the corpus for this family.

TAISCE_INFERENCE_ENDPOINT=${TAISCE_INFERENCE_ENDPOINT:-http://localhost:18000/v1}
TAISCE_INFERENCE_EXTRACTOR_MODEL=${TAISCE_INFERENCE_EXTRACTOR_MODEL:-Qwen/Qwen3.6-35B-A3B}
TAISCE_INFERENCE_API_KEY=${TAISCE_INFERENCE_API_KEY:-}

TAISCE_INFERENCE_EMBEDDING_ENDPOINT=${TAISCE_INFERENCE_EMBEDDING_ENDPOINT:-http://localhost:11434/v1}
TAISCE_INFERENCE_EMBEDDING_MODEL=${TAISCE_INFERENCE_EMBEDDING_MODEL:-qwen3-embedding:4b-q8_0}
TAISCE_INFERENCE_EMBEDDING_API_KEY=${TAISCE_INFERENCE_EMBEDDING_API_KEY:-}

TAISCE_INFERENCE_ALLOWLIST=${TAISCE_INFERENCE_ALLOWLIST:-localhost:18000,localhost:11434}
