# A rented multi-GPU host, for the measurements this machine cannot take.
#
# ── WHAT THIS PROFILE IS FOR ─────────────────────────────────────────────────────────────────────
#
# A laptop runs the model, the database and the service at once, so a figure taken there measures that
# arrangement rather than this system. Latency, throughput and corpus-size claims wait for hardware
# that can be held still — this is the profile for that hardware, and it exists so the scaling work
# has somewhere to point rather than a note saying "somewhere else".
#
# ── WHAT YOU HAVE TO FILL IN, AND WHY IT IS NOT FILLED IN ────────────────────────────────────────
#
# The endpoint. A rented host is a host somebody rented: its address is per-run, and a value committed
# here would be a stale address that either fails or — far worse — reaches whoever holds that address
# now. So it is empty, and an empty endpoint refuses at startup rather than defaulting to anything.
#
#     export TAISCE_INFERENCE_ENDPOINT=https://<the host you rented>/v1
#     export TAISCE_INFERENCE_API_KEY=<its key>
#     export TAISCE_INFERENCE_ALLOWLIST=<that host>
#
# The allowlist is deliberately not pre-filled either. It is the one mechanism that makes sending
# somebody's words somewhere a deliberate act, and a profile that pre-permitted a wildcard host would
# be the mechanism defeated by the file that ships with it.

TAISCE_INFERENCE_ENDPOINT=${TAISCE_INFERENCE_ENDPOINT:-}
TAISCE_INFERENCE_API_KEY=${TAISCE_INFERENCE_API_KEY:-}
TAISCE_INFERENCE_ALLOWLIST=${TAISCE_INFERENCE_ALLOWLIST:-}

# Serve both roles from the rented host if it offers both, or point embedding back at a local model.
TAISCE_INFERENCE_EXTRACTOR_MODEL=${TAISCE_INFERENCE_EXTRACTOR_MODEL:-}
TAISCE_INFERENCE_EMBEDDING_MODEL=${TAISCE_INFERENCE_EMBEDDING_MODEL:-}
TAISCE_INFERENCE_EMBEDDING_ENDPOINT=${TAISCE_INFERENCE_EMBEDDING_ENDPOINT:-}
