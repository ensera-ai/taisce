# Generation hosted by DeepSeek, embedding local.
#
#     export TAISCE_INFERENCE_API_KEY=<your DeepSeek key>     # or DEEPSEEK_API_KEY, which this reads
#     make test-inference INFERENCE_PROFILE=deepseek
#
# ── READ THIS BEFORE USING IT ────────────────────────────────────────────────────────────────────
#
# This sends conversation text to a third party, in whatever jurisdiction that provider operates.
# The product's claim is that data stays on the operator's infrastructure, and with this profile that
# claim is narrower: what a person said reaches the provider in order to be extracted. That is a
# decision only the operator can make, and listing the host below is where they make it.
#
# Embedding stays on the local Ollama. It is a cheap forward pass over short text, and sending it away
# would add a second egress — a report is written from what several people said.
#
# ── WHAT THE CORPUS SAID ─────────────────────────────────────────────────────────────────────────
#
# Measured 2026-09-11 (docs/36-extraction-models.md): `deepseek-flash` holds the extraction contract,
# 19 of 19 corpus cases, three attempts each, with the same relations and refusal reasons as the local
# default. The model reasons before it answers by default — 311 reasoning tokens on a one-sentence
# request — and it returns the reasoning in a separate field, so the answer itself is clean JSON.
# `deepseek-v4-pro` is also served and has not been run through the corpus. Throughput and rate limits
# for a formation worker have not been measured.
#
# ── THE KEY IS NOT IN THIS FILE ──────────────────────────────────────────────────────────────────
#
# Export it. A credential in a file in the repository is a credential in the repository, and this file
# is committed. `DEEPSEEK_API_KEY` is read as a fallback so a key already in the shell is used as it is.

TAISCE_INFERENCE_ENDPOINT=${TAISCE_INFERENCE_ENDPOINT:-https://api.deepseek.com/v1}
TAISCE_INFERENCE_EXTRACTOR_MODEL=${TAISCE_INFERENCE_EXTRACTOR_MODEL:-deepseek-flash}
TAISCE_INFERENCE_API_KEY=${TAISCE_INFERENCE_API_KEY:-${DEEPSEEK_API_KEY:-}}

TAISCE_INFERENCE_EMBEDDING_ENDPOINT=${TAISCE_INFERENCE_EMBEDDING_ENDPOINT:-http://localhost:11434/v1}
TAISCE_INFERENCE_EMBEDDING_MODEL=${TAISCE_INFERENCE_EMBEDDING_MODEL:-qwen3-embedding:4b-q8_0}
TAISCE_INFERENCE_EMBEDDING_API_KEY=${TAISCE_INFERENCE_EMBEDDING_API_KEY:-}

# BOTH hosts. Generation sends a message and embedding sends text written from several of them, so both
# are an egress and neither inherits the other's permission.
TAISCE_INFERENCE_ALLOWLIST=${TAISCE_INFERENCE_ALLOWLIST:-api.deepseek.com,localhost:11434}
