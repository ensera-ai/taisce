# Taisce, on one machine. Copy to `.env` and edit what you need.
#
# Every value here except the model's key has a working default in compose.yaml. This file exists so the
# choices are visible in one place rather than discovered by reading the compose file.

# ── The model ────────────────────────────────────────────────────────────────────────────────────
#
# Extraction needs a model, and the default is DeepSeek's hosted API: nothing to download, and measured
# to hold the extraction contract (docs/36-extraction-models.md). It needs a key, and no key can ship in
# an open repository, so compose refuses `up`, and any other command that reads compose.yaml, until
# TAISCE_INFERENCE_API_KEY has a value. Keep it here, in `.env`, which compose reads on every
# command, and never commit it.
#
#   https://platform.deepseek.com/api_keys
#
# Each stored turn is sent to DeepSeek to be read. The allowlist below is where that is chosen; to keep
# conversation text on your own infrastructure, serve a model yourself (docs/architecture/deployment.md,
# Choosing a model) and point these at it.
#
# Extraction asks for strict JSON against a closed vocabulary of 39 relations. A small model will do
# materially worse than a large one, and that is a property of the model rather than of the system —
# `make test-inference` measures it against a fixed corpus so the difference is visible rather than
# guessed at.
TAISCE_INFERENCE_ENDPOINT=https://api.deepseek.com/v1
TAISCE_INFERENCE_EXTRACTOR_MODEL=deepseek-flash
TAISCE_INFERENCE_API_KEY=

# Which hosts may receive message content. CLOSED WHEN UNSET, deliberately: an allowlist that permits
# everything when empty is one forgotten variable away from not being one.
#
# It is host and port, NOT a URL. `https://api.deepseek.com` matches nothing, and the symptom is an
# instance that starts, stores turns and never forms memory.
TAISCE_INFERENCE_ALLOWLIST=api.deepseek.com

# ── The instance ─────────────────────────────────────────────────────────────────────────────────
TAISCE_PORT=8080
# Optional instance-wide namespace; omit for memory. Never varies by project.
TAISCE_SCHEMA=memory
TAISCE_PROJECT=default

# ── A trap worth knowing about ───────────────────────────────────────────────────────────────────
#
# Docker Compose loads `.env` from this directory automatically, whether you meant it to or not. If a
# `.env` already exists here for something else and it happens to define POSTGRES_PASSWORD, compose
# uses that value — and a database volume initialised under a different one then refuses every
# connection with `password authentication failed`, which reads like a bug in the service.
#
# If that happens: `docker compose down -v` recreates the volume under whatever the current value is.
# That deletes the data, so on anything real, fix the password rather than the volume.

# ── Secrets ──────────────────────────────────────────────────────────────────────────────────────
#
# Change these. They have defaults so that `docker compose up` needs nothing but the model's key, which
# is the point of a quickstart and is not a deployment.
POSTGRES_PASSWORD=taisce
TAISCE_CONTROL_PASSWORD=change-me-control
TAISCE_DATA_PASSWORD=change-me-data
